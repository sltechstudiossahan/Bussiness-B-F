rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace ADMIN_UID with the UID of the one admin account.
    function isAdmin() {
      return request.auth != null && request.auth.uid == "ADMIN_UID";
    }
    match /users/{userId}/businesses/{businessId}/{document=**} {
      allow read, write: if isAdmin() && userId == request.auth.uid
        && businessId in ["food", "farm"];
    }
  }
}
